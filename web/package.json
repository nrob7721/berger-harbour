{
  "name": "berger-harbour-web",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "booking",
    "admin"
  ],
  "scripts": {
    "gen:api": "openapi-typescript shared/openapi/public-api.json -o shared/src/api/public-api.ts && openapi-typescript shared/openapi/admin-api.json -o shared/src/api/admin-api.ts",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.8",
    "vitest": "3.2.7"
  },
  "overrides": {
    "react": "19.2.9",
    "react-dom": "19.2.9"
  }
}
